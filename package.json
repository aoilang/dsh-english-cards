{
  "name": "dsh-english-cards",
  "version": "0.1.0",
  "type": "module",
  "description": "Collects English corrections into a study deck above the composer and a searchable card library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoilang/dsh-english-cards.git"
  },
  "homepage": "https://github.com/aoilang/dsh-english-cards",
  "bugs": {
    "url": "https://github.com/aoilang/dsh-english-cards/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "english",
    "grammar",
    "flashcards",
    "oauth"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "sync.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "SKILL.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/screenshots/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
